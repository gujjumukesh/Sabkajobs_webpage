{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(assets/.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*\\.(js|css|json|png|jpg|jpeg|gif|svg|ico|wasm|otf|ttf))",
      "destination": "/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
